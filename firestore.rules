rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'tier',
        'dailyGenerations',
        'lastUsageDate',
        'totalGenerations',
        'totalCharacters',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'tier',
        'dailyGenerations',
        'lastUsageDate',
        'totalGenerations',
        'totalCharacters',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
      && data.tier is string && data.tier in ['free', 'pro']
      && data.dailyGenerations is int && data.dailyGenerations >= 0 && data.dailyGenerations <= 10000
      && data.lastUsageDate is string && data.lastUsageDate.size() == 10 && data.lastUsageDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
      && data.totalGenerations is int && data.totalGenerations >= 0 && data.totalGenerations <= 1000000
      && data.totalCharacters is int && data.totalCharacters >= 0 && data.totalCharacters <= 100000000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint: VoiceGeneration
    function isValidVoiceGeneration(data) {
      return data.keys().hasAll([
        'id',
        'userId',
        'text',
        'stylePrompt',
        'voiceId',
        'voiceName',
        'isMultiSpeaker',
        'category',
        'language',
        'model',
        'charCount',
        'durationSec',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'id',
        'userId',
        'text',
        'stylePrompt',
        'voiceId',
        'voiceName',
        'secondVoiceId',
        'secondVoiceName',
        'isMultiSpeaker',
        'category',
        'language',
        'model',
        'charCount',
        'durationSec',
        'createdAt'
      ])
      && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
      && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId == request.auth.uid && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.text is string && data.text.size() >= 1 && data.text.size() <= 5500
      && data.stylePrompt is string && data.stylePrompt.size() <= 500
      && data.voiceId is string && data.voiceId.size() >= 1 && data.voiceId.size() <= 100
      && data.voiceName is string && data.voiceName.size() >= 1 && data.voiceName.size() <= 100
      && (!data.keys().hasAny(['secondVoiceId']) || (data.secondVoiceId is string && data.secondVoiceId.size() <= 100))
      && (!data.keys().hasAny(['secondVoiceName']) || (data.secondVoiceName is string && data.secondVoiceName.size() <= 100))
      && data.isMultiSpeaker is bool
      && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
      && data.language is string && data.language.size() >= 1 && data.language.size() <= 40
      && data.model is string && data.model in ['gemini-3.8-flash-lite-tts', 'gemini-3.8-flash-tts']
      && data.charCount is int && data.charCount >= 1 && data.charCount <= 5500
      && data.durationSec is number && data.durationSec >= 0 && data.durationSec <= 3600
      && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().tier == 'free'
        && incoming().dailyGenerations == 0
        && incoming().totalGenerations == 0
        && incoming().totalCharacters == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Record TTS usage
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['dailyGenerations', 'lastUsageDate', 'totalGenerations', 'totalCharacters', 'updatedAt'])
            && incoming().totalGenerations >= existing().totalGenerations
            && incoming().totalCharacters >= existing().totalCharacters
          ) ||
          // Action: Update display name
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          ) ||
          // Action: Switch plan tier
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['tier', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isVerified() && isOwner(userId);

      match /generations/{generationId} {
        allow get: if isValidId(userId)
          && isValidId(generationId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(generationId)
          && isVerified()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidVoiceGeneration(incoming())
          && incoming().id == generationId
          && incoming().userId == userId
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isValidId(userId)
          && isValidId(generationId)
          && isVerified()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}

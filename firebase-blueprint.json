{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Private user profile and TTS usage quota state for a signed-in studio user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "tier": {
          "type": "string",
          "enum": ["free", "pro"],
          "description": "Subscription tier controlling voice access and daily limits."
        },
        "dailyGenerations": {
          "type": "integer",
          "description": "Number of TTS generations used on lastUsageDate."
        },
        "lastUsageDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10,
          "description": "UTC date string (YYYY-MM-DD) for daily quota tracking."
        },
        "totalGenerations": {
          "type": "integer",
          "description": "Lifetime TTS generations count."
        },
        "totalCharacters": {
          "type": "integer",
          "description": "Lifetime characters synthesized."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "tier",
        "dailyGenerations",
        "lastUsageDate",
        "totalGenerations",
        "totalCharacters",
        "createdAt",
        "updatedAt"
      ]
    },
    "VoiceGeneration": {
      "title": "Voice Generation",
      "description": "Metadata record of a synthesized Text-to-Speech clip saved in user history.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Unique generation ID."
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Owner Firebase Auth UID."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5500,
          "description": "Synthesized script text."
        },
        "stylePrompt": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional voice direction/style prompt."
        },
        "voiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Primary voice persona ID."
        },
        "voiceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Primary voice display name."
        },
        "secondVoiceId": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional second voice ID for dual-speaker mode."
        },
        "secondVoiceName": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional second voice name for dual-speaker mode."
        },
        "isMultiSpeaker": {
          "type": "boolean",
          "description": "Whether dual-speaker dialogue synthesis was used."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Voice category name."
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Target language label."
        },
        "model": {
          "type": "string",
          "enum": ["gemini-3.8-flash-lite-tts", "gemini-3.8-flash-tts"],
          "description": "Gemini TTS model identifier."
        },
        "charCount": {
          "type": "integer",
          "description": "Character count of the synthesized script."
        },
        "durationSec": {
          "type": "number",
          "description": "Audio duration in seconds."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "id",
        "userId",
        "text",
        "stylePrompt",
        "voiceId",
        "voiceName",
        "isMultiSpeaker",
        "category",
        "language",
        "model",
        "charCount",
        "durationSec",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile and quota usage state strictly accessible only to the owning user."
    },
    "/users/{userId}/generations/{generationId}": {
      "schema": {
        "$ref": "#/entities/VoiceGeneration"
      },
      "description": "Per-user Text-to-Speech generation history records."
    }
  }
}
